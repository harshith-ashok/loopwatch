LOOPWATCH_ENV=dev
LOOPWATCH_LOG_LEVEL=INFO
LOOPWATCH_DATABASE_URL=postgresql+psycopg://loopwatch:loopwatch@localhost:5433/loopwatch
LOOPWATCH_CORS_ORIGINS=["http://localhost:5173"]
# Edge node. Set EDGE_SIM_ENABLED=false when a real board is posting telemetry.
LOOPWATCH_EDGE_SIM_ENABLED=true
LOOPWATCH_EDGE_NODE=fulfillment-hub-01
# Seed flagged sample incidents and history at startup (excluded from the scorecard).
LOOPWATCH_DEMO_DATA=false
# Agents. LLM_PROVIDER=none runs the rule-based playbook only; ollama uses a local Ollama
# daemon (cloud models need `ollama signin` once).
LOOPWATCH_LLM_PROVIDER=none
LOOPWATCH_LLM_MODEL=gpt-oss:120b-cloud
LOOPWATCH_OLLAMA_URL=http://localhost:11434
LOOPWATCH_LLM_API_KEY=
